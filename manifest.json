{
  "schemaVersion": 1,
  "id": "io.github.fiala06.unifi-overlay",
  "name": "UniFi Overlay",
  "version": "2.0.0",
  "author": "Fiala06",
  "license": "MIT",
  "description": "Pin a live UniFi Protect camera to the corner of the screen, cycle cameras from the bar, show a four-camera grid, and pop up automatically on a doorbell ring.",
  "kinds": [
    "service",
    "bar-widget",
    "overlay"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml",
    "overlay": "Settings.qml"
  },
  "barWidget": {
    "displayName": "UniFi Overlay",
    "description": "Toggle a pinned live camera view and choose the active camera.",
    "category": "Home",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "snapshotIntervalSec": 10,
      "hoverPreview": false
    },
    "schema": [
      {
        "key": "snapshotIntervalSec",
        "type": "integer",
        "label": "Preview refresh (seconds)",
        "min": 2,
        "max": 300,
        "step": 1,
        "defaultValue": 10
      },
      {
        "key": "hoverPreview",
        "type": "boolean",
        "label": "Open the panel on hover",
        "defaultValue": false
      }
    ]
  }
}
