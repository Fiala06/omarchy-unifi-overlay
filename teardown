#!/usr/bin/env bash
# Optional cleanup. `omarchy plugin remove` is enough on its own -- the running
# daemons notice the plugin directory disappearing and stand themselves down,
# and the window rules only ever lived in the running compositor, never in a
# config file.
#
# This exists for the one thing removal cannot do: forget your credentials.
#
#   ./teardown            stop the daemons now, keep the config and API key
#   ./teardown --purge    also delete the config file and the stored API key

set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/unifi-overlay.json"
BRIDGE="$PLUGIN_DIR/bin/unifi-protect"

PURGE=0
[[ "${1:-}" == "--purge" ]] && PURGE=1

info() { printf '  %s\n' "$*"; }

echo "unifi-overlay teardown"

if [[ -x "$BRIDGE" ]]; then
  "$BRIDGE" pip stop >/dev/null 2>&1 || true
  "$BRIDGE" alerts stop >/dev/null 2>&1 || true
  info "stopped the pinned view and the alert listener"
fi

if ((PURGE)); then
  host="$(python3 -c "
import json
try:
    print(json.load(open('$CONFIG_FILE')).get('host',''))
except Exception:
    print('')
" 2>/dev/null || true)"
  if [[ -n "$host" ]] && command -v secret-tool >/dev/null 2>&1; then
    secret-tool clear service unifi-protect host "$host" >/dev/null 2>&1 || true
    info "removed the API key from the keyring"
  fi
  rm -f "$CONFIG_FILE"
  info "removed $CONFIG_FILE"
  rm -rf "${XDG_RUNTIME_DIR:-/tmp}/omarchy-unifi-overlay"
else
  info "kept your config and API key (re-run with --purge to delete them)"
fi

cat <<'NEXT'

Done. Finish with:
  omarchy plugin remove io.github.fiala06.unifi-overlay
NEXT
